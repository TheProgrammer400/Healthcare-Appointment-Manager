generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  HOLD
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  RESCHEDULED
}

enum LlmStatus {
  PENDING
  SUCCESS
  FAILED
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
}

enum ReminderStatus {
  SCHEDULED
  SENT
  FAILED
  CANCELLED
}

enum NotificationType {
  BOOKING_CONFIRMATION
  CANCELLATION
  REMINDER
  LEAVE_CONFLICT
}

enum NotificationChannel {
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
  DELETED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String        @map("password_hash")
  role         UserRole
  fullName     String        @map("full_name")
  phone        String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  sessions          Session[]
  doctorProfile     DoctorProfile?
  patientProfile    PatientProfile?
  googleOAuthToken  GoogleOAuthToken?
  notificationJobs  NotificationJob[]
  calendarEvents    CalendarEvent[]
  auditLogs         AuditLog[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model DoctorProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique @map("user_id")
  specialisation      String
  slotDurationMinutes Int      @default(30) @map("slot_duration_minutes")
  bio                 String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  workingHours DoctorWorkingHours[]
  leaveDays    DoctorLeaveDay[]
  appointments Appointment[]

  @@index([specialisation])
  @@map("doctor_profiles")
}

model DoctorWorkingHours {
  id        String @id @default(cuid())
  doctorId  String @map("doctor_id")
  dayOfWeek Int    @map("day_of_week") // 0=Sunday, 6=Saturday
  startTime String @map("start_time") // HH:mm format
  endTime   String @map("end_time")   // HH:mm format

  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek])
  @@index([doctorId, dayOfWeek])
  @@map("doctor_working_hours")
}

model DoctorLeaveDay {
  id        String   @id @default(cuid())
  doctorId  String   @map("doctor_id")
  leaveDate DateTime @map("leave_date") @db.Date
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, leaveDate])
  @@map("doctor_leave_days")
}

model PatientProfile {
  id          String    @id @default(cuid())
  userId      String    @unique @map("user_id")
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@map("patient_profiles")
}

model Appointment {
  id              String            @id @default(cuid())
  patientId       String            @map("patient_id")
  doctorId        String            @map("doctor_id")
  startAt         DateTime          @map("start_at")
  endAt           DateTime          @map("end_at")
  status          AppointmentStatus @default(PENDING)
  holdExpiresAt   DateTime?         @map("hold_expires_at")
  cancelledReason String?           @map("cancelled_reason")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  patient          PatientProfile    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor           DoctorProfile     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  symptomForm      SymptomForm?
  visitSummary     VisitSummary?
  reminderJobs     ReminderJob[]
  notificationJobs NotificationJob[]
  calendarEvents   CalendarEvent[]

  @@index([doctorId, startAt])
  @@index([patientId, startAt])
  @@map("appointments")
}

model SymptomForm {
  id                String        @id @default(cuid())
  appointmentId     String        @unique @map("appointment_id")
  rawSymptomsText   String        @map("raw_symptoms_text")
  llmUrgency        UrgencyLevel? @map("llm_urgency")
  llmChiefComplaint String?       @map("llm_chief_complaint")
  llmQuestions      Json?         @map("llm_questions")
  llmStatus         LlmStatus     @default(PENDING) @map("llm_status")
  llmError          String?       @map("llm_error")
  submittedAt       DateTime      @default(now()) @map("submitted_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("symptom_forms")
}

model VisitSummary {
  id                String    @id @default(cuid())
  appointmentId     String    @unique @map("appointment_id")
  doctorNotes       String    @map("doctor_notes")
  prescription      Json
  llmPatientSummary String?   @map("llm_patient_summary")
  llmStatus         LlmStatus @default(PENDING) @map("llm_status")
  llmError          String?   @map("llm_error")
  createdAt         DateTime  @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("visit_summaries")
}

model ReminderJob {
  id            String         @id @default(cuid())
  appointmentId String         @map("appointment_id")
  medicineName  String         @map("medicine_name")
  scheduledFor  DateTime       @map("scheduled_for")
  status        ReminderStatus @default(SCHEDULED)
  attemptCount  Int            @default(0) @map("attempt_count")
  lastAttemptAt DateTime?      @map("last_attempt_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@map("reminder_jobs")
}

model NotificationJob {
  id            String              @id @default(cuid())
  userId        String              @map("user_id")
  appointmentId String?             @map("appointment_id")
  type          NotificationType
  channel       NotificationChannel @default(EMAIL)
  payload       Json
  status        NotificationStatus  @default(PENDING)
  attemptCount  Int                 @default(0) @map("attempt_count")
  lastAttemptAt DateTime?           @map("last_attempt_at")
  createdAt     DateTime            @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("notification_jobs")
}

model CalendarEvent {
  id            String     @id @default(cuid())
  appointmentId String     @map("appointment_id")
  userId        String     @map("user_id")
  googleEventId String?    @map("google_event_id")
  syncStatus    SyncStatus @default(PENDING) @map("sync_status")
  lastError     String?    @map("last_error")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, userId])
  @@map("calendar_events")
}

model GoogleOAuthToken {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_oauth_tokens")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?  @map("actor_user_id")
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model IdempotencyKey {
  key           String   @id
  appointmentId String   @map("appointment_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("idempotency_keys")
}

model LoginAttempt {
  id          String   @id @default(cuid())
  email       String
  windowStart DateTime @default(now()) @map("window_start")
  count       Int      @default(1)

  @@index([email, windowStart])
  @@map("login_attempts")
}
