# Database (Neon PostgreSQL)
# Neon Pooled Connection String (for Serverless App Engine)
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Neon Direct Connection String (for Prisma migrations)
DIRECT_DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Groq LLM API
GROQ_API_KEY="gsk_example_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# Authentication & Sessions
SESSION_SECRET="super-secret-32-character-minimum-string-here"
SESSION_TTL_DAYS="7"

# Email Provider (Resend)
RESEND_API_KEY="re_example_key_here"
EMAIL_FROM_ADDRESS="no-reply@clinic.example.com"

# Google Calendar OAuth 2.0
GOOGLE_CLIENT_ID="example_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-example_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/calendar/callback"

# Security & Encryption
TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
CRON_SECRET="cron-super-secret-bearer-token"
ALLOWED_ORIGIN="http://localhost:3000"

# Application Settings
CLINIC_TIMEZONE="Asia/Kolkata"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
